# Public site URL (used for SEO metadata)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Google Analytics / GTM (optional)
# NEXT_PUBLIC_GTM=GTM-XXXXXXX

# Contact form email notifications (optional) — sends visitor messages to your inbox.
# SMTP_HOST=smtp.qq.com          # QQ 邮箱；163: smtp.163.com；企业微信: smtp.exmail.qq.com
# SMTP_PORT=465                  # SSL 端口，一般为 465
# SMTP_SECURE=true               # 465 用 true，587 用 false
# SMTP_USER=your@qq.com          # 发件邮箱（需开启 SMTP 服务）
# SMTP_PASS=your-smtp-auth-code  # 授权码（非登录密码）
# SMTP_TO=your@qq.com            # 收件邮箱（默认同 SMTP_USER）
# SMTP_SUBJECT_PREFIX=【个人站留言】

# Telegram bot for contact form (optional)
# TELEGRAM_BOT_TOKEN=your_bot_token
# TELEGRAM_CHAT_ID=your_chat_id

# Giscus comments (optional) — requires GitHub Discussions enabled on your repo.
# Get these values from https://giscus.app
# NEXT_PUBLIC_GISCUS_REPO=owner/repo
# NEXT_PUBLIC_GISCUS_REPO_ID=
# NEXT_PUBLIC_GISCUS_CATEGORY=Announcements
# NEXT_PUBLIC_GISCUS_CATEGORY_ID=

# Admin panel (optional) — enables /admin to publish blog posts online.
# Set a strong password; the admin route is otherwise disabled.
# ADMIN_PASSWORD=change-me-to-a-strong-password


# Python API (local development; Docker sets this automatically)
# API_INTERNAL_URL=http://127.0.0.1:8000
# Admin session salt — must match between Next.js and FastAPI
# ADMIN_SESSION_SALT=change-me-too
# Set true when served over HTTPS
# COOKIE_SECURE=false

# Site agent (optional; local retrieval works without a key)
# AGENT_LLM_BASE_URL=https://api.deepseek.com/v1
# AGENT_LLM_API_KEY=sk-...
# AGENT_MODEL=deepseek-chat
