# 依赖
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# 测试
/coverage

# Next.js 构建产物
/.next/
/out/
/.turbo/

# 生产构建
/build

# 系统文件
.DS_Store
Thumbs.db
*.pem
*.key

# 日志
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 环境变量（如需提交可自行放开）
.env*
!.env.example
.env.local

# 编辑器 / IDE
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Vercel
.vercel

# TypeScript
*.tsbuildinfo
next-env.d.ts

# 运行时数据（个人信息 JSON / 阅读量统计，绝不提交）
/data

# 个人博客文章（示例文章保留在 content/blog/*/，你自己的放在 _local/）
content/blog/**/_local/
content/blog/**/_drafts/

# Python backend
backend/.venv/
backend/**/__pycache__/
**/*.pyc
